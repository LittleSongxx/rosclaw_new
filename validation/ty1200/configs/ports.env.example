# TY1200 validation port plan.
#
# Source this file before running any validation script:
#   set -a; source validation/ty1200/configs/ports.env; set +a
#
# Every test/benchmark MUST read ports from these variables.
# Hard-coding ports in test code is forbidden (see rosclaw闭环.md §三).

# --- TY1200 model services (vendor docker stack, already running) ---
export TY1200_EMBEDDING_PORT=8000        # Qwen3-Embedding-0.6B (vLLM, OpenAI-compatible)
export TY1200_COSMOS_PORT=8001           # Cosmos-Reason2-2B (vLLM, OpenAI-compatible)
export TY1200_EMBEDDING_ENDPOINT="http://127.0.0.1:${TY1200_EMBEDDING_PORT}/v1"
export TY1200_COSMOS_ENDPOINT="http://127.0.0.1:${TY1200_COSMOS_PORT}/v1"

# --- Site-local LLM (LAN, NOT offline, NOT on-device) ---
# Address is site-local: keep the real value in ~/.rosclaw/providers or
# /etc/rosclaw/providers, never commit it to a public repo.
export TY1200_DEEPSEEK_HOST="${TY1200_DEEPSEEK_HOST:-__SITE_LOCAL_HOST__}"
export TY1200_DEEPSEEK_PORT=31308
export TY1200_DEEPSEEK_ENDPOINT="http://${TY1200_DEEPSEEK_HOST}:${TY1200_DEEPSEEK_PORT}/v1"

# --- ROSClaw services (moved off 8000 to avoid colliding with embedding) ---
export ROSCLAW_MCP_HTTP_PORT=9000
export ROSCLAW_API_PORT=9010
export ROSCLAW_DASHBOARD_PORT=8765

# --- Data services ---
export ROSCLAW_SEEKDB_PORT=2881
export ROSCLAW_SEEKDB_DSN="${ROSCLAW_SEEKDB_DSN:-mysql://root@127.0.0.1:${ROSCLAW_SEEKDB_PORT}/rosclaw}"
export ROSCLAW_REDIS_PORT=6379

# --- ROS bridges (optional containers) ---
export ROS2_ROSBRIDGE_PORT=9090
export ROS1_ROSBRIDGE_PORT=9091
export ROS2_SMOKE_PORT=32887
