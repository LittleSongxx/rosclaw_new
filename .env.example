# Optional local settings for the CMU ARE simulation.
# Large assets are never downloaded automatically; point this at an audited
# asset root before `rosclaw sim cmu-are launch`.
CMU_ARE_ASSET_ROOT=../../third_party
CMU_ARE_WORLD=campus
HEADLESS=true
USE_RVIZ=false
START_ARIADNE2=true
ARIADNE2_ACTIVE=false
ROSBRIDGE_PORT=9090
ROSCLAW_CMU_ARE_ROSBRIDGE_URL=ws://127.0.0.1:9090
