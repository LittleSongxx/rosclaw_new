# ROSClaw ROS1 CMU ARE / ARiADNE2 local configuration.
# Copy to .env for local use. Do not commit .env.

# Compose / container identity
COMPOSE_PROJECT_NAME=rosclaw

# CMU ARE simulation
CMU_ARE_WORLD=campus
HEADLESS=true
USE_RVIZ=true
START_ARIADNE2=true
ARIADNE2_ACTIVE=false
ARIADNE2_USE_RVIZ=false
ARIADNE2_START_DELAY=12
ARIADNE2_LAYERED_PROJECTION=false
ARIADNE2_PROJECTION_Z_BELOW=1.0
ARIADNE2_PROJECTION_Z_ABOVE=1.6
ARIADNE2_PROJECTION_MIN_KNOWN_CELLS=80
ARIADNE2_PROJECTION_ROBOT_CHECK_RADIUS=1.5
ARIADNE2_PROJECTION_MIN_ROBOT_FREE_CELLS=4
ARIADNE2_PROJECTION_OVERLAY_RADIUS=8.0
SPAWN_CAMERA=false
DETACHED=false

# Display / WSLg
LIBGL_ALWAYS_SOFTWARE=1
DISABLE_ROS1_EOL_WARNINGS=1
# Leave DISPLAY/WAYLAND unset in .env so scripts can inherit the active WSLg/X11
# session. ROSClaw uses X11/xcb by default, so the Qt runtime dir can be a
# container-local root-owned directory instead of the host WSLg runtime dir.
# DISPLAY=:0
# WAYLAND_DISPLAY=wayland-0
ROSCLAW_XDG_RUNTIME_DIR=/tmp/runtime-root
QT_QPA_PLATFORM=xcb

# ROSClaw CMU app defaults
CMU_PLACES=docker/ros1/places.campus.yaml
CMU_OUTPUT_DIR=practice_data/app_runs
CMU_NAV_TIMEOUT=120
CMU_READINESS_TIMEOUT=60
CMU_NAV_TOLERANCE=1.5
CMU_SPEED=2.0
CMU_MAX_RELATIVE_M=20
CMU_CHAT_PROGRESS_INTERVAL=3
CMU_MAX_SEQUENCE_STEPS=8
CMU_CIRCLE_SEGMENTS=12
CMU_MAX_CIRCLE_RADIUS=6
CMU_TASK_PREEMPT_POLICY=preempt
CMU_EXPLORATION_ON_MANUAL=pause
CMU_DASHBOARD_HOST=0.0.0.0
CMU_DASHBOARD_PORT=18770
CMU_DASHBOARD_MAX_POINTS=2000

# LLM provider. Fill only in local .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
