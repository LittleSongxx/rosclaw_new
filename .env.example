# Local settings used by the CMU ARE simulation smoke environment.
# The large ARE assets are intentionally outside this Git checkout and are
# verified read-only before Docker is started.
CMU_ARE_ASSET_ROOT=/home/song/code_docker/ros_ws/ARE
CMU_ARE_ROS_BASE_IMAGE=my_ros_noetic:v3
CMU_ARE_WORLD=campus
HEADLESS=true
USE_RVIZ=false
START_ARIADNE2=true
ARIADNE2_ACTIVE=false
ROSBRIDGE_PORT=19090
ROSCLAW_CMU_ARE_ROSBRIDGE_URL=ws://127.0.0.1:19090

# The host-side Python CLI/daemon runs in the `rosclaw` Conda environment.
# The ROS1 Noetic/Gazebo graph runs in the derived `rosclaw-cmu-are-sim`
# container, built from the local `my_ros_noetic:v3` base image.
#
# Recommended invocation:
#   conda activate rosclaw
#   PYTHONPATH=src python -m rosclaw.entrypoint sim cmu-are check --json
